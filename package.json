{
  "name": "bot-music",
  "version": "1.0.0",
  "description": "Bot de música para Discord: YouTube, SoundCloud, Spotify y radios",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "setup": "node scripts/setup-ytdlp.js",
    "postinstall": "node scripts/setup-ytdlp.js",
    "check": "node scripts/check.js",
    "stop": "rm -f bot.pid && echo \"Bot detenido\""
  },
  "keywords": [
    "discord",
    "bot",
    "music",
    "radio",
    "youtube",
    "soundcloud",
    "spotify"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.27.0",
    "dotenv": "^16.3.1",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.11",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "spotify-url-info": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
